# Normalise text to LF in the repo and in every checkout (also on Windows with
# core.autocrlf=true), so levels, solutions and snapshots are byte-identical
# everywhere. Parsers still accept CRLF (docs/tech/level-format.md).
* text=auto eol=lf

# Binary assets: never touch line endings, never diff as text.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.ogg    binary
*.wav    binary
*.mp3    binary
*.flac   binary
*.zip    binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary
*.aseprite binary
*.ase    binary
