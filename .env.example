# Copy to .env and fill in to enable leaderboards. Leave empty to play offline.
# Only the Supabase project URL and the PUBLIC anon key may go here: both are
# bundled into the client. Never put a service-role key in any VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NOT a client value and never a VITE_ variable. Set it as a Supabase function secret only:
#   supabase secrets set IP_HASH_SALT=<a long random string you generate>
# It keys the hash of caller IPs in submit-run. Do not put a real value in this file.
# IP_HASH_SALT=
